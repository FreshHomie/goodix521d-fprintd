+/* Start the work that arrived while the driver was suspended or resuming. */
+static void
+power_settled (FprintDevice *rdev,
+               gboolean      resumed)
+{
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+
+  g_autoptr(SessionData) session = session_data_get (priv);
+  g_autoptr(GDBusMethodInvocation) start = NULL;
+  const char *finger;
+
+  priv->power_pending = FALSE;
+  if (session && session->invocation && priv->current_action == ACTION_NONE &&
+      !fp_device_is_open (priv->dev))
+    claim_open (rdev);
+
+  if (!resumed)
+    {
+      fail_deferred_start (rdev, "Device did not resume from sleep");
+      return;
+    }
+  start = g_steal_pointer (&priv->deferred_start);
+  if (!start)
+    return;
+  g_variant_get (g_dbus_method_invocation_get_parameters (start), "(&s)", &finger);
+  if (g_str_equal (g_dbus_method_invocation_get_method_name (start), "EnrollStart"))
+    fprint_device_enroll_start (FPRINT_DBUS_DEVICE (rdev), start, finger);
+  else
+    fprint_device_verify_start (FPRINT_DBUS_DEVICE (rdev), start, finger);
+}
