+/* FpDevice::removed can fire while a suspend or resume is still in flight, when
+ * libfprint rejects close; finish the removal once that power task settled. */
+static void
+shutdown_if_removed (FprintDevice *rdev)
+{
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  gboolean removed = FALSE;
